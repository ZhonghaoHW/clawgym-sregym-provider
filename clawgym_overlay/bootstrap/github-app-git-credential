#!/usr/bin/env bash
# Git credential helper for the two explicitly approved source repositories.

set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  printf '%s\n' 'github_app_credential_error=root_required' >&2
  exit 1
fi

action="${1:-}"
if [ "$#" -ne 1 ]; then
  exit 1
fi

case "$action" in
  store|erase)
    # Do not persist GitHub credentials in the ecs-user account.
    exit 0
    ;;
  get)
    ;;
  *)
    exit 1
    ;;
esac

protocol=''
host=''
path=''
while IFS= read -r field && [ -n "$field" ]; do
  case "$field" in
    protocol=*) protocol="${field#protocol=}" ;;
    host=*) host="${field#host=}" ;;
    path=*) path="${field#path=}" ;;
  esac
done

case "${protocol}:${host}:${path}" in
  https:github.com:ZhonghaoHW/clawgym.git|https:github.com:ZhonghaoHW/clawgym-sregym-provider.git)
    ;;
  *)
    exit 0
    ;;
esac

token="$(/usr/local/lib/clawgym/github-app-installation-token)"
printf '%s\n' 'username=x-access-token'
printf 'password=%s\n' "$token"
